# ============================================================
# firefly-gen 环境变量示例。复制为 .env 后填写，切勿提交 .env。
# ============================================================

# ---- 应用 ----
APP_ENV=dev                     # dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
API_PORT=18000                  # Compose 暴露到宿主机的 API 端口
WEB_PORT=18080                  # Compose 暴露到宿主机的 Web 面板端口
VITE_USE_MOCK=0                # 容器构建默认连接真实后端；本地纯前端开发可设为 1
APP_SECRET_KEY=change-me-32-bytes-random   # JWT 签名密钥（HS256，≥32 字节），生产必须随机
# Cookie/token/代理密码/R2 Secret/License 字段加密；生成：
#   python -c "from app.core.crypto import generate_key as g; print(g())"
# dev 未设置时从 APP_SECRET_KEY 派生（仅本地），prod 必填
FIELD_ENCRYPTION_KEY=change-me-fernet-key
APP_BASE_URL=http://127.0.0.1:8000
JWT_TTL_HOURS=24

# ---- 引导管理员（用户表落地前的唯一面板账号；生产必须改）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ---- 系统配置服务 ----
DB_AUTO_CREATE=1                 # dev 启动自动建表；prod 置 0 走迁移
CONFIG_CACHE_SECONDS=5           # 热配置进程内缓存
CONFIG_CHANNEL=firefly:config:changed
PROXY_PROBE_URL=https://ipinfo.io/json   # 代理测试目标，需返回 {ip,country}
PROXY_PROBE_TIMEOUT_SECONDS=12
R2_USAGE_CACHE_SECONDS=600

# ---- 数据库 (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://firefly:firefly@127.0.0.1:5432/firefly_gen
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---- Redis (缓存 / 队列 / 分布式锁 / ARP 池) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Celery / 任务队列 ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
GEN_WORKER_CONCURRENCY=32        # 出图/出视频 worker 并发协程数

# ---- ARP 池 (内部服务鉴权) ----
ARP_INTERNAL_TOKEN=change-me-internal-token   # 采集器 → ARP 服务 的内网密钥
ARP_TTL_SECONDS=120              # ARP 入池后视为有效的时间（建议 < 真实 TTL 2~4min）
ARP_MIN_READY=3                  # 池水位低于该值时暂停/降速出图
ARP_MAX_USES=20                  # 单枚 ARP 最大复用次数，408 立即作废

# ---- 采集器 (harvester，独立进程) ----
HARVESTER_TARGET=http://127.0.0.1:8000     # ARP 服务地址（本平台 admin-api）
ARP_INTERVAL=75                  # 铸票间隔秒，必须 < ARP 真实 TTL
HEADLESS=1
# CloakBrowser PRO / fingerprint-chromium 148 可执行文件路径
ADOBE_CHROME_BINARY=
ADOBE_CHROME_ARGS=--fingerprint={seed} --fingerprint-platform=windows --fingerprint-brand=Chrome --lang=en-US --accept-lang=en-US,en;q=0.9 --window-size=1366,768
# 开源 fingerprint-chromium 不需要 License；下列字段仅兼容旧面板
CLOAKBROWSER_LICENSE_KEY=
CLOAKBROWSER_VERSION=148.0.7778.215
CLOAKBROWSER_GEOIP=0
# 默认不屏蔽以保护 ARP 质量；建立基线后仅通过 A/B 逐项尝试 media,image
HARVESTER_BLOCK_RESOURCE_TYPES=
# 住宅 sticky 代理只读 Secret 文件（一行一条），不得提交 Git
ARP_PROXY_FILE=secrets/arp_proxies.txt
ARP_PROXY_SCHEME=http

# ---- 上游账号池 (Adobe Firefly，HARD 付费号) ----
# 账号数据不入库明文，走加密存储；此处仅示例导入路径
ACCOUNTS_IMPORT_PATH=
# 仅本机真实链路测试；不要复制进项目或镜像
TEST_COOKIE_FILE=

# ---- 出图提交默认 ----
# curl_cffi 开源版当前无 chrome148 标签；使用其最新可用 TLS profile（当前 chrome146），
# 再以 ARP bundle 覆盖真实 148 浏览器的 UA / Client-Hints。
SUBMIT_IMPERSONATE=chrome146
SUBMIT_BROWSER_MAJOR=148         # 对外声明身份；必须与铸票浏览器一致
SUBMIT_JA3=                      # 可选：CloakBrowser PRO 提供 148 JA3 时启用自定义 TLS
SUBMIT_AKAMAI=                   # 可选：与 SUBMIT_JA3 成对配置
SYNC_TIMEOUT_SECONDS=180
POLL_TIMEOUT_SECONDS=120
DOWNLOAD_VIA_PROXY=0             # 预签名 CDN 建议直连（0），住宅代理拉大图易超时

# ---- 对象存储 (生成结果，可选 S3/MinIO) ----
STORAGE_BACKEND=local            # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
